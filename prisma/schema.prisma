////////////////////////////////////////////////////////////////////////////

enum StatutCredit {
  NON_PAYE
  EN_COURS
  PAYE
}

enum MethodePaiement {
  BANKILY
  MASRVI
  SEDAD
  AUTRE
}

enum StatutPaiementAbonnement {
  EN_ATTENTE
  APPROUVE
  REJETE
}

enum ModeCommande {
  LIVRAISON
  RETRAIT
}

enum StatutCommande {
  NOUVELLE
  EN_PREPARATION
  PRETE
  EN_LIVRAISON
  RECUPEREE
  LIVREE
  REFUSEE
  ANNULEE
}

enum StatutPaiementCommande {
  EN_ATTENTE
  PAYEE
}

