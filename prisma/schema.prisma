// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// Les utilisateurs (commerçants, clients, administrateurs)
// Les commerçants se connectent pour acceder à leur boutique et gérer leurs produits, commandes et crédits.
// Les clients se connectent pour passer des commandes et les gérer.
// Les administrateurs se connectent pour gérer les commerçants et leurs abonnements.Tout en répondant aux messages des clients.
//////////////////////////////////////////////////

model Utilisateur {
  id         Int      @id @default(autoincrement())
  prenom     String
  nom        String
  telephone  String   @unique
  motDePasse String
  estAdmin   Boolean  @default(false)
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  commercant Commercant?
  client     Client?
}

model Commercant {
  id                  Int                  @id @default(autoincrement())
  utilisateurId       Int                  @unique
  description         String?
  ville               String?
  quartier            String?
  pays                String               @default("Mauritanie")
  finEssaiGratuit     DateTime             @default(now())
  finAbonnement       DateTime?
  paiementsAbonnement PaiementAbonnement[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  utilisateur Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  emprunteurs Emprunteur[]
  credits     Credit[]
  boutique    Boutique?
}

model Client {
  id            Int      @id @default(autoincrement())
  utilisateurId Int      @unique
  adresse       String?
  quartier      String?
  ville         String?
  pays          String   @default("Mauritanie")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  commandes   Commande[]
}

model Emprunteur {
  id           Int      @id @default(autoincrement())
  commercantId Int
  prenom       String
  nom          String
  telephone    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  commercant Commercant @relation(fields: [commercantId], references: [id], onDelete: Cascade)
  credits    Credit[]

  @@index([commercantId])
}

//////////////////////////////////////////////////
// Les crédits un crédit est renseigné par un commerçant en choisissant l'emprunteur et le montant.
// Le commerçant peut ensuite enregistrer les paiements effectués par l'emprunteur pour ce crédit.
//////////////////////////////////////////////////

model Credit {
  id           Int          @id @default(autoincrement())
  commercantId Int
  emprunteurId Int
  montantTotal Decimal      @db.Decimal(12, 2)
  montantPaye  Decimal      @default(0) @db.Decimal(12, 2)
  description  String?
  statutCredit StatutCredit @default(NON_PAYE)
  dateCredit   DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  commercant Commercant @relation(fields: [commercantId], references: [id], onDelete: Cascade)
  emprunteur Emprunteur @relation(fields: [emprunteurId], references: [id], onDelete: Cascade)
  paiements  Paiement[]

  @@index([commercantId])
  @@index([emprunteurId])
}

model Paiement {
  id           Int      @id @default(autoincrement())
  creditId     Int
  montant      Decimal  @db.Decimal(12, 2)
  datePaiement DateTime @default(now())
  observation  String?
  createdAt    DateTime @default(now())

  credit Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([creditId])
}

//////////////////////////////////////////////////
// Le commerçant peut gérer sa boutique, ses produits et les commandes passées par les clients.
//////////////////////////////////////////////////

model Boutique {
  id                  Int      @id @default(autoincrement())
  commercantId        Int      @unique
  nom                 String
  slug                String   @unique
  description         String?
  telephone           String
  quartier            String?
  ville               String?
  logoUrl             String?
  couvertureUrl       String?
  estActive           Boolean  @default(true)
  livraisonDisponible Boolean  @default(false)
  retraitDisponible   Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  commercant Commercant @relation(fields: [commercantId], references: [id], onDelete: Cascade)
  produits   Produit[]
  commandes  Commande[]
}

model Produit {
  id          Int      @id @default(autoincrement())
  boutiqueId  Int
  nom         String
  description String?
  prix        Decimal  @db.Decimal(12, 2)
  disponible  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  boutique       Boutique        @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  images         ImageProduit[]
  lignesCommande LigneCommande[]

  @@index([boutiqueId])
}

model ImageProduit {
  id        Int      @id @default(autoincrement())
  produitId Int
  url       String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())

  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  @@index([produitId])
}

//////////////////////////////////////////////////
// Les commandes
//////////////////////////////////////////////////

model Commande {
  id                    Int                    @id @default(autoincrement())
  boutiqueId            Int
  clientId              Int
  nomDestinataire       String
  telephoneDestinataire String
  adresseLivraison      String?
  quartierLivraison     String?
  villeLivraison        String?
  commentaire           String?
  montantTotal          Decimal                @db.Decimal(12, 2)
  mode                  ModeCommande
  statutCommande        StatutCommande         @default(NOUVELLE)
  statutPaiement        StatutPaiementCommande @default(EN_ATTENTE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  boutique Boutique        @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lignes   LigneCommande[]

  @@index([boutiqueId])
  @@index([clientId])
}

model LigneCommande {
  id           Int     @id @default(autoincrement())
  commandeId   Int
  produitId    Int
  nomProduit   String
  prixUnitaire Decimal @db.Decimal(12, 2)
  quantite     Int
  total        Decimal @db.Decimal(12, 2)

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit  Produit  @relation(fields: [produitId], references: [id], onDelete: Restrict)

  @@index([commandeId])
  @@index([produitId])
}

//////////////////////////////////////////////////
// Les abonnements des commerçants
//////////////////////////////////////////////////

model PaiementAbonnement {
  id               Int                      @id @default(autoincrement())
  commercantId     Int
  methodePaiement  MethodePaiement
  montant          Decimal                  @db.Decimal(12, 2)
  justificatifUrl  String
  statut           StatutPaiementAbonnement @default(EN_ATTENTE)
  motifRejet       String?
  nombreMois       Int                      @default(1)
  dateVerification DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  commercant Commercant @relation(fields: [commercantId], references: [id], onDelete: Cascade)

  @@index([commercantId])
}

//////////////////////////////////////////////////
// Les messages de contact des clients
//////////////////////////////////////////////////

model MessageContact {
  id          Int       @id @default(autoincrement())
  prenom      String
  nom         String
  telephone   String?
  email       String?
  sujet       String
  message     String
  lu          Boolean   @default(false)
  repondu     Boolean   @default(false)
  dateLecture DateTime?
  dateReponse DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

